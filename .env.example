# Copy values into .env.development / .env.test / .env.production as needed.
# Do not commit secrets. OAuth client IDs/secrets stay in local or CI secret stores.

MAIN_VITE_APP_ENV=development
MAIN_VITE_BACKUP_PROVIDER=mock
MAIN_VITE_LICENSE_MODE=unlocked
VITE_APP_NAME=Materiel
VITE_APP_ENV=development

# Optional: seed demo inventory when the DB is empty (dev only)
# MAIN_VITE_SEED_DEMO=true

# Optional DB key override (hex 64-char or any string). Prefer Electron safeStorage in-app.
# MATERIEL_DB_KEY=
# MAIN_VITE_DB_KEY=

# Future (not used by scaffold stubs):
# MAIN_VITE_GOOGLE_CLIENT_ID=
# MAIN_VITE_ONEDRIVE_CLIENT_ID=
