# Copy values into .env.development / .env.test / .env.production as needed.
# Do not commit secrets. OAuth client secrets stay in local or CI secret stores.

MAIN_VITE_APP_ENV=development
MAIN_VITE_BACKUP_PROVIDER=mock
MAIN_VITE_LICENSE_MODE=unlocked
VITE_APP_NAME=Materiel
VITE_APP_ENV=development

# Optional: seed demo inventory when the DB is empty (dev only)
# MAIN_VITE_SEED_DEMO=true

# Optional DB key override (hex 64-char or any string). Prefer Electron safeStorage in-app.
# MATERIEL_DB_KEY=
# MAIN_VITE_DB_KEY=

# License HMAC secret (issuer CLI + app verify). Never commit production values.
# LICENSE_SIGNING_SECRET=
# MAIN_VITE_LICENSE_SIGNING_SECRET=
# See docs/license.md — npm run license:issue -- --email user@example.com

# Cloud backup OAuth (Google Drive / OneDrive). Client IDs are OK in local env;
# never commit client secrets. See docs/backup.md.
# MAIN_VITE_BACKUP_PROVIDER=google-drive
# MAIN_VITE_GOOGLE_CLIENT_ID=
# MAIN_VITE_GOOGLE_CLIENT_SECRET=
# MAIN_VITE_BACKUP_PROVIDER=onedrive
# MAIN_VITE_ONEDRIVE_CLIENT_ID=
# MAIN_VITE_ONEDRIVE_CLIENT_SECRET=
